# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Use * only for local dev — lock this down to your real domain in production.
# Example: ALLOWED_ORIGINS=https://meet.example.com,https://www.example.com
ALLOWED_ORIGINS=*

# ─── HTTPS ───────────────────────────────────────────────────────────────────
# Set HTTPS=true and provide cert paths to enable TLS directly on the server.
# In most cloud/container deployments TLS is terminated upstream (load balancer
# or reverse proxy), so leave HTTPS=false and omit the cert paths.
HTTPS=false
# SSL_KEY_PATH=/etc/ssl/private/server.key
# SSL_CERT_PATH=/etc/ssl/certs/server.crt

# ─── SFU / media (mediasoup) ─────────────────────────────────────────────────
# Media no longer flows client-to-client: every participant sends one copy to
# this server and the server forwards it. That means this process needs a
# reachable address and a UDP port range of its own.

# THE address browsers are told to send media to. On a server with a public IP
# this MUST be set explicitly — autodetection finds the machine's private
# address, ICE then advertises a candidate nobody can route to, and the symptom
# is a call that connects and carries no audio or video. Set it to the public
# IPv4 address of this host (not a hostname).
# MEDIASOUP_ANNOUNCED_IP=203.0.113.10

# The interface to bind on. 0.0.0.0 is correct behind NAT and on most VPS
# hosts; announced address above is what remote clients actually use.
MEDIASOUP_LISTEN_IP=0.0.0.0

# UDP/TCP range for media. Every one of these ports must be open in the
# firewall and security group, or calls fail at random as the range is used.
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# One worker is one CPU core. Defaults to min(cores, 4).
# MEDIASOUP_NUM_WORKERS=4

# mediasoup worker logging: none | error | warn | debug
MEDIASOUP_LOG_LEVEL=warn
